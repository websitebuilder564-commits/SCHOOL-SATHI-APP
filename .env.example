# ==============================================================================
# n8n AI Chatbot & Workflow Automation Integration
# ==============================================================================
# VITE_N8N_WEBHOOK_URL:
#   The full URL of your n8n "Webhook" trigger node or "Chat Trigger" / AI Agent node.
#   - Production Example: "https://your-domain.app.n8n.cloud/webhook/schoolsaathi-chat"
#   - Test Example:       "https://your-domain.app.n8n.cloud/webhook-test/schoolsaathi-chat"
#
#   Expected n8n Webhook Node Settings:
#   - HTTP Method: POST
#   - Path: /schoolsaathi-chat (or any custom webhook path)
#   - Response Mode: "Respond to Webhook Node" or "Last Node"
#
#   Incoming Payload format sent by N8nChatbot to n8n:
#   {
#     "action": "sendMessage",
#     "sessionId": "session_1724068000000_a1b2c3",
#     "chatInput": "User's question or message",
#     "message": "User's question or message",
#     "text": "User's question or message",
#     "role": "student" | "parent" | "teacher" | "principal" | "user",
#     "activeTab": "dashboard" | "general",
#     "metadata": {
#       "source": "SchoolSaathi n8n WebChat",
#       "platform": "Web",
#       "timestamp": "2026-08-19T11:18:00.000Z"
#     }
#   }
#
#   Expected Output format returned from n8n to N8nChatbot:
#   - JSON (Recommended): { "output": "Markdown response text", "suggestions": ["Follow-up 1", "Follow-up 2"] }
#   - Alternative JSON:   { "text": "..." } OR { "response": "..." } OR { "message": "..." }
#   - Plain Text:         "Direct string response"
#
VITE_N8N_WEBHOOK_URL=""

# VITE_N8N_BEARER_TOKEN:
#   Optional authorization token for protected n8n webhooks.
#   If provided, requests include the header: "Authorization: Bearer <token>"
VITE_N8N_BEARER_TOKEN=""

